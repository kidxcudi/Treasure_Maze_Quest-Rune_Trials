import * as THREE from 'three';
import { AnimationSystem } from '../../../core/utils/animation.js';

// Constants
const EFFECT_DURATIONS = {
  FLIGHT: {
    BOUNCE: 0.3,
    ASCENT: 0.7,
    SUSPEND: 3,
    DESCENT: 1
  },
  BLINK: {
    TELEPORT: 0.15,
    COOLDOWN: 0.15
  },
  STRENGTH: 5000,
  SPEED: 4000,
  VISION: 5000
};

const VISUAL_CONFIG = {
  FLIGHT_HEIGHT: 3,
  BOUNCE_HEIGHT: 0.3,
  BLINK_DISTANCE: 5,
  BLINK_BUFFER: 0.5,
  MIN_FLOOR_HEIGHT: 1
};

// Shared easing functions
const Easing = {
  bounce: t => {
    const n1 = 7.5625, d1 = 2.75;
    if (t < 1 / d1) return n1 * t * t;
    if (t < 2 / d1) return n1 * (t -= 1.5 / d1) * t + 0.75;
    if (t < 2.5 / d1) return n1 * (t -= 2.25 / d1) * t + 0.9375;
    return n1 * (t -= 2.625 / d1) * t + 0.984375;
  },
  quad: t => t * (2 - t),
  linear: t => t
};

export class RuneEffects {
  static rune_flight(player, scene, hud) {
    const camera = player.controls.object;
    const originalY = camera.position.y;
    
    // Bounce phase
    AnimationSystem({
      duration: EFFECT_DURATIONS.FLIGHT.BOUNCE,
      from: originalY,
      to: originalY + VISUAL_CONFIG.BOUNCE_HEIGHT,
      ease: Easing.bounce,
      onUpdate: y => camera.position.y = y,
      onComplete: () => this._ascendFlight(camera, originalY, hud)
    });
    
    hud?.showMessage("You prepare to float...");
  }

  static _ascendFlight(camera, originalY, hud) {
    AnimationSystem({
      duration: EFFECT_DURATIONS.FLIGHT.ASCENT,
      from: camera.position.y,
      to: originalY + VISUAL_CONFIG.FLIGHT_HEIGHT,
      ease: Easing.quad,
      onUpdate: y => camera.position.y = y,
      onComplete: () => {
        hud?.showMessage("You float above the ground...");
        setTimeout(() => this._descendFlight(camera, originalY, hud), 
          EFFECT_DURATIONS.FLIGHT.SUSPEND * 1000);
      }
    });
  }

  static _descendFlight(camera, originalY, hud) {
    AnimationSystem({
      duration: EFFECT_DURATIONS.FLIGHT.DESCENT,
      from: camera.position.y,
      to: originalY,
      ease: Easing.quad,
      onUpdate: y => camera.position.y = y,
      onComplete: () => hud?.showMessage("Flight fades.")
    });
  }

  static rune_blink(player, scene, hud) {
    const obj = player.controls.object;
    const direction = new THREE.Vector3();
    player.controls.getDirection(direction).normalize();

    const raycaster = new THREE.Raycaster(obj.position.clone(), direction);
    const obstacles = this._getObstacles(scene);
    const intersections = raycaster.intersectObjects(obstacles, true);
    
    const blinkDistance = this._calculateBlinkDistance(intersections);
    if (blinkDistance <= 0) {
      hud?.showMessage("Blink blocked! Too close to obstacle.");
      return;
    }

    const newPos = this._calculateBlinkPosition(obj, direction, blinkDistance);
    this._animateBlink(obj, newPos, hud);
  }

  static _getObstacles(scene) {
    const obstacles = [];
    scene.traverse(child => {
      if (child.userData?.isObstacle) obstacles.push(child);
    });
    return obstacles;
  }

  static _calculateBlinkDistance(intersections) {
    if (intersections.length === 0) return VISUAL_CONFIG.BLINK_DISTANCE;
    return Math.max(0, intersections[0].distance - VISUAL_CONFIG.BLINK_BUFFER);
  }

  static _calculateBlinkPosition(obj, direction, distance) {
    const newPos = obj.position.clone()
      .add(direction.multiplyScalar(distance));
    newPos.y = Math.max(newPos.y, VISUAL_CONFIG.MIN_FLOOR_HEIGHT);
    return newPos;
  }

  static _animateBlink(obj, newPos, hud) {
    // Scale down
    AnimationSystem({
      duration: EFFECT_DURATIONS.BLINK.TELEPORT,
      from: 1,
      to: 0.1,
      ease: Easing.linear,
      onUpdate: scale => obj.scale.setScalar(scale),
      onComplete: () => {
        obj.position.copy(newPos);
        // Scale up
        AnimationSystem({
          duration: EFFECT_DURATIONS.BLINK.COOLDOWN,
          from: 0.1,
          to: 1,
          ease: Easing.linear,
          onUpdate: scale => obj.scale.setScalar(scale),
          onComplete: () => hud?.showMessage("You blink forward through space.")
        });
      }
    });
  }

  static rune_strength(player, scene, hud) {
    player.canBreakWalls = true;
    hud?.showMessage("You feel powerful... walls can be broken!");
    
    setTimeout(() => {
      player.canBreakWalls = false;
      hud?.showMessage("Your strength fades.");
    }, EFFECT_DURATIONS.STRENGTH);
  }

  static rune_speed(player, scene, hud) {
    const originalSpeed = player.getMovementSpeed();
    player.setMovementSpeed(originalSpeed * 2);
    hud?.showMessage("You feel a burst of speed!");
    
    setTimeout(() => {
      player.setMovementSpeed(originalSpeed);
      hud?.showMessage("Speed fades.");
    }, EFFECT_DURATIONS.SPEED);
  }

  static rune_vision(player, scene, hud) {
    const overlay = this._createVisionOverlay();
    document.body.appendChild(overlay);

    const originalMaterials = this._applyXrayMaterials(scene);
    this._animateVisionOverlay(overlay, hud);

    setTimeout(() => {
      this._restoreMaterials(scene, originalMaterials);
      document.body.removeChild(overlay);
      hud?.showMessage("The vision fades...");
    }, EFFECT_DURATIONS.VISION);
  }

  static _createVisionOverlay() {
    const overlay = document.createElement('div');
    Object.assign(overlay.style, {
      position: 'fixed',
      top: 0,
      left: 0,
      width: '100vw',
      height: '100vh',
      pointerEvents: 'none',
      background: 'radial-gradient(circle, rgba(255,255,255,0.25) 0%, transparent 80%)',
      opacity: '0',
      zIndex: '9999',
      mixBlendMode: 'screen',
      transition: 'background-size 0.5s ease'
    });
    return overlay;
  }

  static _applyXrayMaterials(scene) {
    const originalMaterials = new Map();
    const highlightColors = {
      treasure: 0xffff00,
      exit: 0x42a5f5,
      obstacle: 0x999999
    };

    scene.traverse(obj => {
      if (obj.userData?.isTreasure) {
        this._replaceMaterial(obj, highlightColors.treasure, originalMaterials);
      } else if (obj.name === "exit_door") {
        this._replaceMaterial(obj, highlightColors.exit, originalMaterials);
      } else if (obj.userData?.breakable || obj.userData?.passThrough) {
        this._replaceMaterial(obj, highlightColors.obstacle, originalMaterials);
      }
    });

    return originalMaterials;
  }

  static _replaceMaterial(obj, color, materialMap) {
    if (!obj.material) return;
    materialMap.set(obj, obj.material);
    obj.material = new THREE.MeshBasicMaterial({
      color,
      transparent: true,
      opacity: 0.4,
      depthTest: false,
      depthWrite: false,
      blending: THREE.AdditiveBlending
    });
  }

  static _animateVisionOverlay(overlay, hud) {
    hud?.showMessage("Your eyes glow with insight...");
    
    AnimationSystem({
      duration: 0.5,
      from: 0,
      to: 1,
      onUpdate: val => {
        overlay.style.opacity = val;
        const size = 100 + val * 50;
        overlay.style.backgroundSize = `${size}% ${size}%`;
      }
    });
  }

  static _restoreMaterials(scene, originalMaterials) {
    originalMaterials.forEach((material, obj) => {
      if (obj.material?.dispose) obj.material.dispose();
      obj.material = material;
    });
  }
}

